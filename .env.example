# Скопируйте в .env:  cp .env.example .env  и заполните значения.
# Пароли делайте только из букв и цифр (например: openssl rand -hex 24),
# иначе спецсимволы сломают строку подключения.

POSTGRES_DB=ognepek
POSTGRES_USER=ognepek
POSTGRES_PASSWORD=замените_на_длинный_пароль

# Вход на страницу /admin
ADMIN_PASSWORD=замените_на_пароль_админки
# Случайная строка не короче 32 символов: openssl rand -hex 32
ADMIN_SESSION_SECRET=замените_на_случайную_строку
BUSINESS_TIME_ZONE=Europe/Moscow

# Домен сайта. ОБЯЗАТЕЛЕН для входа в /admin: cookie админки работает только по HTTPS.
# Пока домена нет, оставьте :80 (сайт откроется, но войти в /admin не получится).
DOMAIN=:80

# Версия PostgreSQL. Должна быть не ниже версии базы в Neon.
PG_VERSION=17

# Только для разового переноса данных (migrate-data.sh)
NEON_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
